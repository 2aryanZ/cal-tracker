{
  "expo": {
    "name": "Cal Tracker",
    "slug": "cal-tracker",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caltracker",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.caltracker.app",
      "buildNumber": "7",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cal Tracker uses your camera to scan meals, recognize food items, and calculate calories and macronutrients.",
        "NSPhotoLibraryUsageDescription": "Cal Tracker accesses your photo library to let you select meal photos for AI nutrition breakdown.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.caltracker.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#152B30"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#152B30",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cal Tracker to access your camera to scan and identify meals.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cal Tracker to access your photos to analyze nutrition in saved meal pictures.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#305948"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2f6f8ba-fab3-4dce-b9a1-0305bf109955"
      }
    },
    "owner": "aryan_i"
  }
}
