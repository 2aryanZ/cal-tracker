{
  "expo": {
    "name": "Cal AI - Calorie Tracker",
    "slug": "cal-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caltracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.caltracker.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cal AI uses your camera to scan meals, recognize food items, and calculate calories and macronutrients.",
        "NSPhotoLibraryUsageDescription": "Cal AI accesses your photo library to let you select meal photos for AI nutrition breakdown.",
        "NSMicrophoneUsageDescription": "Cal AI may use the microphone during meal recording sessions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.caltracker.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#102123"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102123",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cal AI to access your camera to scan and identify meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cal AI to access your photos to analyze nutrition in saved meal pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#059669"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2f6f8ba-fab3-4dce-b9a1-0305bf109955"
      }
    },
    "owner": "aryan_i"
  }
}
